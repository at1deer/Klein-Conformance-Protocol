{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klein Runbook v1",
  "type": "object",
  "required": [
    "runbook_version",
    "source_artifact_hash",
    "source_artifact_type",
    "profile",
    "mode",
    "substrate_fingerprint",
    "timebase",
    "planned_steps"
  ],
  "additionalProperties": false,
  "properties": {
    "runbook_version": { "const": "klein.runbook.v1" },
    "runbook_id": { "type": ["string", "null"] },
    "source_artifact_hash": { "$ref": "#/definitions/sha256_ref" },
    "source_artifact_type": { "type": "string", "enum": ["project", "container"] },
    "profile": { "$ref": "#/definitions/profile" },
    "mode": { "type": "string", "enum": ["HARD", "ENVELOPE", "DIAGNOSTIC"] },
    "substrate_fingerprint": {
      "anyOf": [{ "$ref": "#/definitions/sha256_ref" }, { "type": "null" }]
    },
    "timebase": { "const": "DEVICE_TICKS" },
    "planned_steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/planned_step" }
    },
    "metadata": { "type": "object" }
  },
  "definitions": {
    "sha256_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "profile": {
      "type": "object",
      "required": ["profile_id", "profile_version"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 }
      }
    },
    "planned_step": {
      "type": "object",
      "required": ["step_id", "tick", "operation", "payload_ref", "frame_ref", "expected_effect"],
      "additionalProperties": false,
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "tick": { "type": "integer", "minimum": 0 },
        "operation": {
          "type": "string",
          "enum": ["DMF_SET_CHANNELS", "DMF_APPLY_FRAME", "DMF_APPLY_BITMAP"]
        },
        "payload_ref": { "type": ["string", "null"] },
        "frame_ref": { "type": ["string", "null"] },
        "expected_effect": {
          "type": "object",
          "required": ["type", "details"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["simulated", "unspecified"] },
            "details": { "type": "object" }
          }
        }
      }
    }
  }
}