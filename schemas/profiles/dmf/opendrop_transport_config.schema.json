{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klein OpenDrop Transport Config v1",
  "type": "object",
  "required": [
    "transport_config_version",
    "transport_kind",
    "hardware_io_enabled",
    "requires_explicit_enable",
    "endpoint",
    "baud_rate",
    "protocol_family",
    "command_encoding",
    "untested_hardware_warning",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "transport_config_version": { "const": "klein.opendrop_transport_config.v1" },
    "transport_kind": { "type": "string", "enum": ["none", "serial_experimental"] },
    "hardware_io_enabled": { "const": false },
    "requires_explicit_enable": { "const": true },
    "endpoint": { "const": null },
    "baud_rate": { "const": null },
    "protocol_family": { "type": "string", "enum": ["opendrop_arduino_style"] },
    "command_encoding": { "type": "string", "enum": ["jsonl", "text_lines"] },
    "untested_hardware_warning": { "const": true },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
