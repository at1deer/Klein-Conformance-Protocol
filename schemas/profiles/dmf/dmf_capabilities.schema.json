{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klein DMF/EWOD Profile Capabilities v1 Alpha",
  "type": "object",
  "required": ["addressing", "electrical", "payloads", "sensing", "recovery"],
  "additionalProperties": false,
  "properties": {
    "addressing": {
      "type": "object",
      "required": ["mode", "max_channels", "grid_width", "grid_height"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["channel", "direct"] },
        "max_channels": { "type": "integer", "minimum": 1 },
        "grid_width": { "type": "integer", "minimum": 1 },
        "grid_height": { "type": "integer", "minimum": 1 }
      }
    },
    "electrical": {
      "type": "object",
      "required": ["voltage_min_v", "voltage_max_v", "frequency_min_hz", "frequency_max_hz"],
      "additionalProperties": false,
      "properties": {
        "voltage_min_v": { "type": "number" },
        "voltage_max_v": { "type": "number" },
        "frequency_min_hz": { "type": "number" },
        "frequency_max_hz": { "type": "number" }
      }
    },
    "payloads": {
      "type": "object",
      "required": [
        "supported_payload_kinds",
        "supported_frame_formats",
        "unsupported_frame_formats"
      ],
      "additionalProperties": false,
      "properties": {
        "supported_payload_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["CHANNEL_LIST", "FRAME_SEQUENCE", "BITMAP_SEQUENCE"] }
        },
        "supported_frame_formats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["sparse", "bitmap", "delta_tiles"] }
        },
        "unsupported_frame_formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["rle"] }
        }
      }
    },
    "sensing": {
      "type": "object",
      "required": [
        "sensing_model",
        "supports_runtime_observations",
        "supports_physical_sensor_attestation"
      ],
      "additionalProperties": false,
      "properties": {
        "sensing_model": { "type": "string", "enum": ["simulated", "none"] },
        "supports_runtime_observations": { "type": "boolean" },
        "supports_physical_sensor_attestation": { "const": false }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["supports_bounded_ecrp_evidence", "supports_closed_loop_recovery"],
      "additionalProperties": false,
      "properties": {
        "supports_bounded_ecrp_evidence": { "type": "boolean" },
        "supports_closed_loop_recovery": { "const": false }
      }
    }
  }
}
