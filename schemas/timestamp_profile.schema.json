{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klein Timestamp Profile v1",
  "type": "object",
  "required": [
    "timestamp_profile_version",
    "profile_id",
    "profile_kind",
    "trusted_time_claimed",
    "allowed_token_kinds",
    "requires_external_time_authority",
    "trust_roots",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "timestamp_profile_version": { "const": "klein.timestamp_profile.v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_kind": { "type": "string", "enum": ["mock_local", "rfc3161_future"] },
    "trusted_time_claimed": { "type": "boolean" },
    "allowed_token_kinds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["mock_local", "rfc3161_future"] }
    },
    "requires_external_time_authority": { "type": "boolean" },
    "trust_roots": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
