{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klein Attestation Profile v1",
  "type": "object",
  "required": [
    "attestation_profile_version",
    "profile_id",
    "profile_kind",
    "hardware_attestation_claimed",
    "allowed_statement_kinds",
    "requires_hardware_root",
    "trust_roots",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "attestation_profile_version": { "const": "klein.attestation_profile.v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_kind": { "type": "string", "enum": ["mock_none", "hardware_future"] },
    "hardware_attestation_claimed": { "type": "boolean" },
    "allowed_statement_kinds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["none", "mock", "hardware_future"] }
    },
    "requires_hardware_root": { "type": "boolean" },
    "trust_roots": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
