{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KCP Run Bundle Result v1",
  "type": "object",
  "required": [
    "result_version",
    "overall_status",
    "bundle_path",
    "bundle_format",
    "checks",
    "errors",
    "warnings",
    "signed_conformance_result",
    "bundle_hashes",
    "resolved_paths",
    "hail_digest",
    "hail_chain_digest",
    "run_manifest_key_ids",
    "trust_status",
    "backend_id",
    "profile_id",
    "artifact_hash",
    "substrate_fingerprint",
    "backend_registry_hash",
    "registry_signed",
    "registry_signature_status",
    "registry_provenance_status",
    "registry_authority_id",
    "key_lifecycle_status",
    "backend_capabilities_present",
    "backend_capability_declaration_hash",
    "backend_capability_signature_status",
    "backend_capability_trust_status",
    "backend_capability_scope_status",
    "backend_capability_error_code",
    "declared_conformance_levels",
    "verified_conformance_levels",
    "conformance_level_catalog_status",
    "conformance_level_dependency_status",
    "conformance_level_error_code"
  ],
  "additionalProperties": false,
  "properties": {
    "result_version": {
      "const": "klein.run_bundle_result.v1"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "bundle_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "bundle_format": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "directory",
        "zip",
        null
      ]
    },
    "checks": {
      "type": "object",
      "required": [
        "bundle_schema_status",
        "bundle_entry_hash_status",
        "artifact_schema_status",
        "signed_conformance_status"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle_schema_status": {
          "$ref": "#/definitions/status"
        },
        "bundle_entry_hash_status": {
          "$ref": "#/definitions/status"
        },
        "artifact_schema_status": {
          "$ref": "#/definitions/status"
        },
        "signed_conformance_status": {
          "$ref": "#/definitions/status"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "signed_conformance_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "bundle_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "resolved_paths": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "hail_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "hail_chain_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_manifest_key_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_status": {
      "type": "string"
    },
    "backend_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_schema_status": {
      "$ref": "#/definitions/status"
    },
    "artifact_canonicalization": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_validation_error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "substrate_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend_registry_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_signed": {
      "type": "boolean"
    },
    "registry_signature_status": {
      "type": "string"
    },
    "registry_provenance_status": {
      "type": "string"
    },
    "registry_authority_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_lifecycle_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend_capabilities_present": {
      "type": "boolean"
    },
    "backend_capability_declaration_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend_capability_signature_status": {
      "type": "string"
    },
    "backend_capability_trust_status": {
      "type": "string"
    },
    "backend_capability_scope_status": {
      "type": "string"
    },
    "backend_capability_error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "declared_conformance_levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_conformance_levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conformance_level_catalog_status": {
      "type": "string"
    },
    "conformance_level_dependency_status": {
      "type": "string"
    },
    "conformance_level_error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_applicable",
        "not_evaluated"
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "check",
        "error_code",
        "message"
      ],
      "additionalProperties": true,
      "properties": {
        "check": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
