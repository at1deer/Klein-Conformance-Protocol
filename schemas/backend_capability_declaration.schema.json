{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klein Backend Capability Declaration v1",
  "type": "object",
  "required": ["capability_declaration_version", "payload", "signatures"],
  "additionalProperties": false,
  "properties": {
    "capability_declaration_version": { "const": "klein.backend_capability_declaration.v1" },
    "payload": {
      "type": "object",
      "required": [
        "declaration_id",
        "backend_id",
        "backend_version",
        "issued_at",
        "not_before",
        "not_after",
        "supported_profiles",
        "supported_conformance_levels",
        "supported_execution_modes",
        "supported_hail_features",
        "supported_evidence_features",
        "profile_capabilities",
        "substrates",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "declaration_id": { "type": "string", "minLength": 1 },
        "backend_id": { "type": "string", "minLength": 1 },
        "backend_version": { "type": "string", "minLength": 1 },
        "issued_at": { "type": ["string", "null"] },
        "not_before": { "type": ["string", "null"] },
        "not_after": { "type": ["string", "null"] },
        "supported_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/profile" }
        },
        "supported_conformance_levels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "supported_execution_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["HARD", "ENVELOPE", "DIAGNOSTIC"] }
        },
        "supported_hail_features": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "supported_evidence_features": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "hil": { "$ref": "#/definitions/hil" },
        "profile_capabilities": { "type": "object" },
        "substrates": {
          "type": "array",
          "items": { "$ref": "#/definitions/substrate" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/signature" }
    }
  },
  "definitions": {
    "profile": {
      "type": "object",
      "required": ["profile_id", "profile_versions", "profile_capability_set"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "profile_capability_set": { "type": "string", "minLength": 1 }
      }
    },
    "substrate": {
      "type": "object",
      "required": [
        "substrate_id",
        "substrate_capabilities_hash",
        "substrate_topology_hash",
        "substrate_fingerprint",
        "fingerprint_canonicalization"
      ],
      "additionalProperties": false,
      "properties": {
        "substrate_id": { "type": "string", "minLength": 1 },
        "substrate_capabilities_hash": { "$ref": "#/definitions/sha256_ref" },
        "substrate_topology_hash": { "$ref": "#/definitions/sha256_ref" },
        "substrate_fingerprint": { "$ref": "#/definitions/sha256_ref" },
        "fingerprint_canonicalization": { "const": "klein.canon.json.v1" }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "signature_algorithm",
        "key_id",
        "public_key_encoding",
        "public_key",
        "signature_encoding",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "signature_algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "public_key_encoding": { "const": "base64.raw.ed25519" },
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
        "signature_encoding": { "const": "base64.raw.ed25519" },
        "signature": { "type": "string" }
      }
    },
    "hil": {
      "type": "object",
      "required": [
        "hil_readiness",
        "hil_contract_hash",
        "hil_levels_supported",
        "hardware_execution_supported",
        "hardware_attestation_supported"
      ],
      "additionalProperties": false,
      "properties": {
        "hil_readiness": { "type": "boolean" },
        "hil_contract_hash": {
          "anyOf": [
            { "$ref": "#/definitions/sha256_ref" },
            { "type": "null" }
          ]
        },
        "hil_levels_supported": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "hardware_execution_supported": { "type": "boolean" },
        "hardware_attestation_supported": { "type": "boolean" }
      }
    },
    "sha256_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
